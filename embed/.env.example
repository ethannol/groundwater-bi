# Copy to embed/.env (gitignored) and fill in from Metabase:
#   Admin settings -> Embedding -> Static embedding -> embedding secret key
METABASE_SITE_URL=http://localhost:3000
METABASE_SECRET_KEY=replace-me
# The dashboard you created in Metabase with a locked "huc8" parameter.
METABASE_DASHBOARD_ID=1
# Token lifetime in seconds. Short on purpose; the host app re-mints on load.
EMBED_TOKEN_TTL=600
